{
  "name": "mook-ai-portfolio",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "scripts": {
    "build": "vite build",
    "dev": "vite build && wrangler dev --env development --local --persist-to .wrangler/state",
    "dev:vite": "vite dev",
    "preview": "vite build && wrangler dev --remote",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate:local",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260329.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "eslint-plugin-svelte": "^3.16.0",
    "globals": "^17.4.0",
    "svelte-check": "^4.4.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "wrangler": "^4.78.0"
  },
  "dependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "hono": "^4.12.9",
    "jose": "^6.2.2",
    "svelte": "^5.55.1",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.3",
    "zod": "^4.3.6"
  }
}
